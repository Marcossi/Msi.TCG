<Application x:Class="Msi.TemplateCodeGenerator.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Msi.TemplateCodeGenerator"
             xmlns:ui="using:Msi.TemplateCodeGenerator"
             xmlns:dockFluent="using:Dock.Avalonia.Themes.Fluent">
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <dockFluent:DockFluentTheme />
    </Application.Styles>
</Application>
