<Window x:Class="Msi.TemplateCodeGenerator.UI.Views.Shell.MainWindow"
        x:ClassModifier="internal"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:Msi.TemplateCodeGenerator.UI.Views.Shell"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        Title="Template Code Generator" Height="600" Width="1000">
        <!--d:DataContext="{d:DesignInstance Type=shell:MainShellViewModel, IsDesignTimeCreatable=False}"-->       
    <shell:MainShellView />
</Window>
