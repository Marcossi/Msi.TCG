<UserControl x:Class="Msi.TemplateCodeGenerator.UI.ProjectExplorer.ProjectExplorerShellView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Msi.TemplateCodeGenerator.UI.Settings"
             mc:Ignorable="d" 
             x:ClassModifier="internal"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
            <TextBlock Text="Explorador de proyectos"
                       HorizontalAlignment="Center"
                       FontSize="20"/>
            <TextBlock Text="Proyecto actual:" />
            <TextBlock Text="{Binding ProjectName}" />
            <Button Content="Refrescar"
                    Command="{Binding RefreshProjectContextCommand}"
                    Width="120" />
        </StackPanel>
    </Grid>
</UserControl>
