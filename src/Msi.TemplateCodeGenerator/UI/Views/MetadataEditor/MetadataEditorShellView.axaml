<UserControl x:Class="Msi.TemplateCodeGenerator.UI.Views.MetadataEditor.MetadataEditorShellView"
              x:ClassModifier="internal"
              xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              xmlns:local="clr-namespace:Msi.TemplateCodeGenerator.UI.Views.MetadataEditor"
              mc:Ignorable="d" 
              d:DesignHeight="450" d:DesignWidth="800">

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" 
                Background="#F0F0F0" 
                Padding="4"
                BorderBrush="#CCCCCC"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="Guardar" 
                        Command="{Binding SaveCommand}"
                        ToolTip.Tip="Guardar (Ctrl+S)"
                        Padding="8,4"
                        MinWidth="80"/>
            </StackPanel>
        </Border>

        <!-- Editor + Preview -->
        <Grid ColumnDefinitions="*, 4, *">
            <!-- Editor JSON (Izquierda) -->
            <TextBox Grid.Column="0"
                     Text="{Binding Content}"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     FontFamily="Consolas, Monospace, Courier New"
                     VerticalContentAlignment="Top"
                     PlaceholderText="Edita el JSON de metadata aquí..."
                     BorderThickness="1"
                     BorderBrush="#CCCCCC"
                     CornerRadius="0"/>
            
            <!-- Splitter -->
            <GridSplitter Grid.Column="1" 
                          ResizeDirection="Columns" 
                          Background="#DDDDDD" />

            <!-- Preview (Derecha) -->
            <Grid Grid.Column="2" RowDefinitions="*,Auto">
                <!-- Preview normal -->
                <TextBox Grid.Row="0"
                         Text="{Binding PreviewContent}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         FontFamily="Consolas, Monospace, Courier New"
                         VerticalContentAlignment="Top"
                         PlaceholderText="Preview con defaults aplicados..."
                         BorderThickness="1"
                         BorderBrush="#CCCCCC"
                         CornerRadius="0"
                         IsVisible="{Binding !HasError}"/>
                
                <!-- Preview con error (ocupa todo el espacio cuando hay error) -->
                <TextBox Grid.Row="0"
                           Text="{Binding PreviewContent}"
                           IsReadOnly="True"
                           AcceptsReturn="True"
                           Foreground="Red"
                           Background="Transparent"
                           BorderThickness="0"
                           TextWrapping="Wrap"
                           FontFamily="Consolas, Monospace, Courier New"
                           VerticalContentAlignment="Top"
                           Margin="8"
                           IsVisible="{Binding HasError}"/>
                
                <!-- Error panel (dockado abajo) -->
                <Border Grid.Row="1" 
                        Background="#FFE0E0" 
                        IsVisible="{Binding HasError}"
                        Padding="8">
                    <TextBlock Text="Error de sintaxis JSON" 
                               Foreground="Red" 
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
