<UserControl x:Class="Msi.TemplateCodeGenerator.UI.Views.ProjectExplorer.ProjectExplorerShellView"
              xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:converters="clr-namespace:Msi.TemplateCodeGenerator.UI.Views.ProjectExplorer.Converters"
              xmlns:vm="clr-namespace:Msi.TemplateCodeGenerator.UI.Views.ProjectExplorer.ViewModels"
             mc:Ignorable="d"
             x:ClassModifier="internal"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <converters:FileTypeToIconConverter x:Key="FileTypeToIcon" />
        <converters:FileTypeToForegroundConverter x:Key="FileTypeToForeground" />
        <converters:BoolToInverseConverter x:Key="BoolToInverse" />
        <FontFamily x:Key="SegoeIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </UserControl.Resources>
    <DockPanel>

        <!-- Barra de herramientas -->
        <Border DockPanel.Dock="Top"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                Padding="4,2">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Command="{Binding RefreshProjectContextCommand}"
                        ToolTip.Tip="Refrescar ficheros"
                        Width="26" Height="26"
                        Padding="0" FontSize="14"
                        Content="↻" />
                <Button Command="{Binding CreateTestDocumentCommand}"
                        ToolTip.Tip="[TEST] Crear Documento"
                        Width="26" Height="26"
                        Padding="0" FontSize="13"
                        Content="＋" />
            </StackPanel>
        </Border>

        <!-- Árbol de ficheros del proyecto -->
        <TreeView x:Name="FileTree" ItemsSource="{Binding FileTree}" SelectedItem="{Binding SelectedFileEntry}"
                  DoubleTapped="OnTreeViewDoubleTapped"
                  PointerMoved="OnTreeViewPointerMoved"
                  PointerReleased="OnTreeViewPointerReleased"
                  DragDrop.AllowDrop="True"
                  DragDrop.DragOver="OnTreeViewDragOver"
                  DragDrop.Drop="OnTreeViewDrop">
            <TreeView.KeyBindings>
                <KeyBinding Gesture="F2" Command="{Binding RenameCommand}" CommandParameter="{Binding SelectedItem, ElementName=FileTree}" />
                <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" CommandParameter="{Binding SelectedItem, ElementName=FileTree}" />
            </TreeView.KeyBindings>
            <TreeView.Styles>
                <Style Selector="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="DragDrop.AllowDrop" Value="True" />
                </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}">
                    <Panel>
                        <!-- Modo visualización -->
                        <StackPanel Orientation="Horizontal" Spacing="4"
                                    IsVisible="{Binding IsEditing, Converter={StaticResource BoolToInverse}}">
                            <TextBlock Text="{Binding Type, Converter={StaticResource FileTypeToIcon}}"
                                       Foreground="{Binding Type, Converter={StaticResource FileTypeToForeground}}"
                                       FontFamily="{StaticResource SegoeIconFont}" />
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="❌"
                                       Foreground="Red"
                                       IsVisible="{Binding HasError}"
                                        ToolTip.Tip="{Binding ErrorMessage}" />
                         </StackPanel>
                         <!-- Modo edición inline -->
                         <TextBox Text="{Binding EditingName, Mode=TwoWay}"
                                  IsVisible="{Binding IsEditing}"
                                  KeyDown="OnEditingTextBoxKeyDown"
                                  LostFocus="OnEditingTextBoxLostFocus" />
                    </Panel>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</UserControl>
