{
  // Configuración de Serilog
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/Msi.TemplateCodeGenerator-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "shared": true
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/Msi.TemplateCodeGenerator-last.log",
          "shared": true
        }
      }
    ],
    // Enrichers añaden información contextual extra a cada log
    "Enrich": [ 
        "FromLogContext", // Permite añadir propiedades dinámicas usando LogContext.PushProperty
        "WithMachineName", // Añade la propiedad MachineName
        "WithThreadId" // Añade la propiedad ThreadId
    ]
  }
}
